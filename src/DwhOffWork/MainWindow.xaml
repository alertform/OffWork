<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DwhOffWork.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent"
          Padding="20,14,20,18"
          RowSpacing="12"
          Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="下班小助手" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentTimeText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12" />
            </StackPanel>
            <ToggleButton x:Name="PinButton"
                          Grid.Column="1"
                          IsChecked="True"
                          Click="PinButton_Click"
                          ToolTipService.ToolTip="保持窗口置顶"
                          AutomationProperties.Name="保持窗口置顶">
                <FontIcon Glyph="&#xE840;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="10">
            <StackPanel Spacing="2">
                <TextBlock x:Name="StatusLabel"
                           Text="距离下班"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="13" />
                <TextBlock x:Name="CountdownText"
                           Text="00:00:00"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="36"
                           FontWeight="SemiBold" />
            </StackPanel>
            <ProgressBar x:Name="WorkProgressBar"
                         Minimum="0"
                         Maximum="100"
                         Height="6"
                         AutomationProperties.Name="今日工作进度" />
            <TextBlock x:Name="ProgressText"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="今天已经赚了"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="13" />
                <TextBlock x:Name="EarnedText"
                           Text="¥0.00"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="DailySalaryText"
                       Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" />
        </Grid>

        <Expander x:Name="SettingsExpander"
                  Grid.Row="3"
                  Header="设置"
                  Expanding="SettingsExpander_Expanding"
                  Collapsed="SettingsExpander_Collapsed">
            <StackPanel Padding="0,10,0,0" Spacing="12">
                <TimePicker x:Name="StartTimePicker"
                            Header="上班时间"
                            ClockIdentifier="24HourClock"
                            MinuteIncrement="5"
                            HorizontalAlignment="Stretch" />
                <TimePicker x:Name="EndTimePicker"
                            Header="下班时间"
                            ClockIdentifier="24HourClock"
                            MinuteIncrement="5"
                            HorizontalAlignment="Stretch" />
                <NumberBox x:Name="DailySalaryBox"
                           Header="日薪（元）"
                           Minimum="0"
                           Maximum="1000000"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="10"
                           PlaceholderText="例如 500" />
                <InfoBar x:Name="ValidationInfoBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Error"
                         Message="上下班时间不能相同，日薪不能为负数。" />
                <Button Content="保存设置"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click" />
                <TextBlock Text="设置会自动保存在这台电脑上"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="11" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
